# Chroniq Environment Variables
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to version control.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── VAPID (Web Push) ───────────────────────────────────────────────────────
# Generate with: deno eval "import {generateVapidKeys} from 'jsr:@negrel/webpush@^0.5.0'; console.log(JSON.stringify(await generateVapidKeys()))"
# The PUBLIC key is safe to expose in the frontend.
# The PRIVATE key must NEVER be in frontend code — store it in Supabase Vault.

VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
