# Chroniq Environment Variables Template
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit your real secrets to version control.

# --- Supabase Configuration ---
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy alias:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Web Push (VAPID) ---
# Generate using: npx web-push generate-vapid-keys
# Client public key (Vite):
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
# Backend Edge Function Secrets (set in Supabase Project Settings / Secrets):
# VAPID_PUBLIC_KEY=your-vapid-public-key-here
# VAPID_PRIVATE_KEY=your-vapid-private-key-here
# VAPID_SUBJECT=mailto:notifications@yourdomain.com

# --- Application URL ---
# For local development: http://localhost:5173
# For production GitHub Pages: https://<username>.github.io/<repo>/
VITE_APP_URL=http://localhost:5173
